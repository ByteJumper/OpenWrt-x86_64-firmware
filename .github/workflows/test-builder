#
# https://github.com/ByteJumper/OpenWrt-x86_64-firmware
#
# File: .github/workflows/test-builder.yml
# Description: Build ImmortalWrt using GitHub Actions
# Version: 0.3
#

name: Build ImmortalWrt

on:
  repository_dispatch:
  workflow_dispatch:
  # schedule:
    # - cron: '0 0 * * 0'

env:
  REPO_URL: https://github.com/immortalwrt/immortalwrt
  REPO_BRANCH: master
  FEEDS_CONF: feeds.conf.default
  CONFIG_FILE: .config
  DIY_P1_SH: diy-part1.sh
  DIY_P2_SH: diy-part2.sh
  UPLOAD_BIN_DIR: false
  UPLOAD_FIRMWARE: true
  UPLOAD_RELEASE: true
  TZ: Asia/Shanghai

jobs:
  build:
    runs-on: ubuntu-20.04
    timeout-minutes: 480

    steps:
    - name: Checkout
      uses: actions/checkout@main

    - name: Initialization environment
      env:
        DEBIAN_FRONTEND: noninteractive
      run: |
        # Clean disk space (optional, comment if not needed)
        # sudo rm -rf /etc/apt/sources.list.d/* /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
        # sudo docker image prune --all --force

        sudo -E apt-get -qq update
        # Install dependencies based on ImmortalWrt official requirements
        sudo -E apt-get -qq install -y ack antlr3 asciidoc autoconf automake autopoint binutils bison build-essential \
          bzip2 ccache clang cmake cpio curl device-tree-compiler ecj fastjar flex gawk gettext gcc-multilib \
          g++-multilib git gnutls-dev gperf haveged help2man intltool lib32gcc-s1 libc6-dev-i386 libelf-dev \
          libglib2.0-dev libgmp3-dev libltdl-dev libmpc-dev libmpfr-dev libncurses-dev libpython3-dev \
          libreadline-dev libssl-dev libtool libyaml-dev libz-dev lld llvm lrzsz mkisofs msmtp nano \
          ninja-build p7zip p7zip-full patch pkgconf python3 python3-pip python3-ply python3-docutils \
          python3-distutils python3-setuptools python3-pyelftools qemu-utils re2c rsync scons squashfs-tools \
          subversion swig texinfo uglifyjs upx-ucl unzip vim wget xmlto xxd zlib1g-dev zstd

        sudo -E apt-get -qq autoremove --purge
        sudo -E apt-get -qq clean
        sudo timedatectl set-timezone "$TZ"

        # Create working directory without sudo when possible
        mkdir -p /workdir
        # Only use sudo if necessary, and ensure correct ownership
        sudo chown $(id -u):$(id -g) /workdir 2>/dev/null || true

    - name: Clone source code
      working-directory: /workdir
      run: |
        df -hT $PWD
        git clone $REPO_URL -b $REPO_BRANCH --single-branch --filter=blob:none openwrt
        # Use relative path instead of absolute symlink to avoid permission issues
        ln -sf /workdir/openwrt $GITHUB_WORKSPACE/openwrt

    - name: Load custom feeds
      run: |
        # Use cp instead of mv to preserve original files
        if [ -e $FEEDS_CONF ]; then
          cp $FEEDS_CONF openwrt/feeds.conf.default
        fi
        if [ -e $DIY_P1_SH ]; then
          chmod +x $DIY_P1_SH
          cd openwrt
          $GITHUB_WORKSPACE/$DIY_P1_SH
        fi

    - name: Update feeds
      run: cd openwrt && ./scripts/feeds update -a

    - name: Install feeds
      run: cd openwrt && ./scripts/feeds install -a

    - name: Load custom configuration
      run: |
        # Use cp instead of mv to preserve original files
        if [ -e files ]; then
          cp -r files/* openwrt/files/ 2>/dev/null || cp -r files openwrt/
        fi
        if [ -e $CONFIG_FILE ]; then
          cp $CONFIG_FILE openwrt/.config
        fi
        if [ -e $DIY_P2_SH ]; then
          chmod +x $DIY_P2_SH
          cd openwrt
          $GITHUB_WORKSPACE/$DIY_P2_SH
        fi

    - name: Download package
      id: package
      run: |
        cd openwrt
        make defconfig
        make download -j8
        find dl -size -1024c -exec ls -l {} \;
        find dl -size -1024c -exec rm -f {} \;

    - name: Compile the firmware
      id: compile
      run: |
        cd openwrt
        echo "$(nproc) thread compile"
        make -j$(nproc) || make -j1 || make -j1 V=s
        echo "status=success" >> $GITHUB_OUTPUT
        grep '^CONFIG_TARGET.*DEVICE.*=y' .config | sed -r 's/.*DEVICE_(.*)=y/\1/' > DEVICE_NAME
        if [ -s DEVICE_NAME ]; then
          echo "DEVICE_NAME=_$(cat DEVICE_NAME)" >> $GITHUB_ENV
        fi
        echo "FILE_DATE=_$(date +"%Y%m%d%H%M")" >> $GITHUB_ENV

    - name: Check space usage
      if: (!cancelled())
      run: df -hT

    - name: Upload bin directory
      uses: actions/upload-artifact@v4
      if: steps.compile.outputs.status == 'success' && env.UPLOAD_BIN_DIR == 'true'
      with:
        name: ImmortalWrt_bin${{ env.DEVICE_NAME }}${{ env.FILE_DATE }}
        path: openwrt/bin
        retention-days: 7

    - name: Organize files
      id: organize
      if: env.UPLOAD_FIRMWARE == 'true' && !cancelled()
      run: |
        cd openwrt/bin/targets/*/*
        rm -rf packages
        echo "FIRMWARE=$PWD" >> $GITHUB_ENV
        echo "status=success" >> $GITHUB_OUTPUT
        echo "Available firmware files:"
        ls -lh *.img *.img.gz *.vmdk *.iso 2>/dev/null || echo "No firmware files found"

    - name: Upload firmware directory (Artifact backup)
      uses: actions/upload-artifact@v4
      if: steps.organize.outputs.status == 'success' && !cancelled()
      with:
        name: ImmortalWrt_firmware${{ env.DEVICE_NAME }}${{ env.FILE_DATE }}
        path: ${{ env.FIRMWARE }}
        retention-days: 7
        compression-level: 0

    - name: Generate release tag
      id: tag
      if: env.UPLOAD_RELEASE == 'true' && steps.organize.outputs.status == 'success' && !cancelled()
      run: |
        echo "release_tag=$(date +"%Y.%m.%d-%H%M")" >> $GITHUB_OUTPUT
        cat > release.txt << 'EOF'
# ImmortalWrt Firmware Release

## Build Information
- **Build Date**: EOF
        echo "$(date +"%Y-%m-%d %H:%M:%S %Z")" >> release.txt
        cat >> release.txt << 'EOF'
- **Repository**: EOF
        echo "${{ github.repository }}" >> release.txt
        cat >> release.txt << 'EOF'
- **Run ID**: EOF
        echo "${{ github.run_id }}" >> release.txt
        cat >> release.txt << 'EOF'
- **Source**: EOF
        echo "${{ env.REPO_URL }} (${{ env.REPO_BRANCH }} branch)" >> release.txt
        cat >> release.txt << 'EOF'

## Firmware Details
- **Device**: EOF
        echo "${{ env.DEVICE_NAME }}" >> release.txt
        cat >> release.txt << 'EOF'
- **Target**: x86_64
- **Filesystem**: SquashFS / Ext4

## Default Settings
- **Default IP**: 192.168.1.1 (ImmortalWrt default)
- **Default Password**: (none)

## Download
Firmware files are attached below. If download fails, you can also get them from:
GitHub Actions -> Run #EOF
        echo "${{ github.run_id }}" >> release.txt
        cat >> release.txt << 'EOF' -> Artifacts

## Notes
- This is an automated build from GitHub Actions
- For more information, visit: https://github.com/immortalwrt/immortalwrt
EOF
        echo "status=success" >> $GITHUB_OUTPUT

    - name: Upload firmware to release (Primary)
      id: upload_release
      uses: softprops/action-gh-release@v1
      if: steps.tag.outputs.status == 'success' && env.UPLOAD_RELEASE == 'true' && !cancelled()
      continue-on-error: true
      with:
        token: ${{ secrets.RELEASE_TOKEN }}
        tag_name: ${{ steps.tag.outputs.release_tag }}
        name: ImmortalWrt Firmware ${{ steps.tag.outputs.release_tag }}
        body_path: release.txt
        files: ${{ env.FIRMWARE }}/*
        fail_on_unmatched_files: false
        generate_release_notes: false
        prerelease: false
        draft: false

    - name: Check release upload status
      if: steps.tag.outputs.status == 'success' && env.UPLOAD_RELEASE == 'true' && !cancelled()
      run: |
        if [ "${{ steps.upload_release.outcome }}" = "success" ]; then
          echo "Release created successfully!"
          echo "RELEASE_STATUS=success" >> $GITHUB_ENV
        else
          echo "Warning: Release upload failed, but firmware is saved as Artifact"
          echo "RELEASE_STATUS=failed" >> $GITHUB_ENV
          echo ""
          echo "You can download the firmware from:"
          echo "https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}"
          echo ""
          echo "To manually create a release later:"
          echo "1. Go to Actions -> This run -> Artifacts"
          echo "2. Download ImmortalWrt_firmware_*"
          echo "3. Manually create a release and upload the files"
        fi

    - name: Delete workflow runs
      uses: Mattraks/delete-workflow-runs@main
      with:
        retain_days: 3
        keep_minimum_runs: 5

    - name: Remove old Releases
      uses: dev-drprasad/delete-older-releases@master
      if: env.UPLOAD_RELEASE == 'true' && env.RELEASE_STATUS == 'success' && !cancelled()
      with:
        keep_latest: 3
        delete_tags: true
      env:
        GITHUB_TOKEN: ${{ secrets.RELEASE_TOKEN }}

    - name: Build Summary
      if: always()
      run: |
        echo "## Build Summary" >> $GITHUB_STEP_SUMMARY
        echo "" >> $GITHUB_STEP_SUMMARY
        echo "| Item | Status |" >> $GITHUB_STEP_SUMMARY
        echo "|------|--------|" >> $GITHUB_STEP_SUMMARY
        echo "| Compile Firmware | ${{ steps.compile.outputs.status }} |" >> $GITHUB_STEP_SUMMARY
        echo "| Upload Artifact | ${{ steps.organize.outputs.status }} |" >> $GITHUB_STEP_SUMMARY
        echo "| Create Release | ${{ steps.upload_release.outcome }} |" >> $GITHUB_STEP_SUMMARY
        echo "" >> $GITHUB_STEP_SUMMARY
        if [ "${{ steps.upload_release.outcome }}" != "success" ]; then
          echo "### Note" >> $GITHUB_STEP_SUMMARY
          echo "Release upload failed, but firmware is available as Artifact." >> $GITHUB_STEP_SUMMARY
          echo "Download from: Actions -> ${{ github.run_id }} -> Artifacts" >> $GITHUB_STEP_SUMMARY
        else
          echo "### Success" >> $GITHUB_STEP_SUMMARY
          echo "Release created: https://github.com/${{ github.repository }}/releases/tag/${{ steps.tag.outputs.release_tag }}" >> $GITHUB_STEP_SUMMARY
        fi
        echo "" >> $GITHUB_STEP_SUMMARY
        echo "### Firmware Files" >> $GITHUB_STEP_SUMMARY
        echo '```' >> $GITHUB_STEP_SUMMARY
        ls -la ${{ env.FIRMWARE }} 2>/dev/null | grep -E '\.(img|gz|vmdk|iso)' || echo "No firmware files found" >> $GITHUB_STEP_SUMMARY
        echo '```' >> $GITHUB_STEP_SUMMARY
